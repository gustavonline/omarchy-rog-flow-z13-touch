#!/usr/bin/env bash

set -euo pipefail

readonly binary="${Z13_OSK_BINARY:-$HOME/.local/libexec/z13-osk/wvkbd-z13}"
readonly theme_helper="${Z13_OSK_THEME_HELPER:-$HOME/.local/bin/z13-theme}"

if [[ ! -x "$binary" ]]; then
  printf 'z13-osk: missing executable: %s\n' "$binary" >&2
  exit 1
fi
if [[ ! -x "$theme_helper" ]]; then
  printf 'z13-osk: missing theme helper: %s\n' "$theme_helper" >&2
  exit 1
fi

mapfile -t palette < <("$theme_helper")
if (( ${#palette[@]} != 6 )); then
  printf 'z13-osk: theme helper returned an invalid palette\n' >&2
  exit 1
fi
bg=${palette[0]} key=${palette[1]} special=${palette[2]}
press=${palette[3]} accent=${palette[4]} text=${palette[5]}

exec "$binary" \
  --auto --hidden --no-popup \
  --fn 'Inter 19' --alpha 255 -R 10 \
  --bg "$bg" --fg "$key" --fg-sp "$special" \
  --press "$press" --press-sp "$press" \
  --swipe "$accent" --swipe-sp "$accent" \
  --text "$text" --text-sp "$text" \
  --text-press "$text" --text-press-sp "$text" \
  --text-swipe "$bg" --text-swipe-sp "$bg"
